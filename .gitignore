# Python bytecode and local environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Local credentials and machine-specific settings
.env
.env.*
!.env.example

# Python test, type-checker, and editor caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.cache/
.idea/
.vscode/
*.code-workspace

# Python packaging/build output
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Generated training weights and downloaded model binaries
training/checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Large transient diagnostic captures; compact metrics, evaluations,
# experiment configs, and written reports remain eligible for version control.
python-example/logs/observation_diagnostics/live_observations_*.jsonl
training/logs/guide_early_1m_v1/contact_diagnostics/
training/logs/reward_scales/

# Other generated output
*.log
*.tmp
*.temp
*.prof
*.trace
*.pid
*.seed

# This root lockfile has no matching package.json and declares no dependencies.
/package-lock.json

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Independent upstream/working checkouts: preserve locally, do not stage as
# accidental embedded-repository pointers from the root repository.
/python-example/
/python-example-original/
/training/reports/v6_upstream_source_*/

# Real-game trajectories, processed tensors and neighbor-search arrays.
# Source, protocols, manifests, hashes and compact written reports stay visible.
/training/**/*.jsonl
/training/**/*.bin
/training/**/*.npy
/training/**/*.npz
/training/**/*.h5
/training/**/*.hdf5
/training/**/*.parquet

# Per-callback/per-publication evidence and generated launch/test configurations.
/training/**/summary_snapshots/
/training/**/publication_snapshots/
/training/**/preflight/
/training/**/prepared/
/training/**/*_query_evidence.json
/training/**/callback_windows.json
/training/**/history.json

# Failed download attempt and temporary diagnostic benchmark output.
/training/reports/v6_upstream_source_/
